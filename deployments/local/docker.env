APP_ENV=docker

# --- PostgreSQL: 1 database = 1 bounded context, masing-masing di depan PgBouncer ---
# Tiap microservice membaca <MODULE>_DB_* dan menunjuk ke PgBouncer context-nya.
DB_DRIVER=postgres
DB_USERNAME=postgres
DB_PASSWORD=password

# Konteks bounded (referensi / tooling):
DB_IDENTITY_HOST=pgbouncer_identity
DB_IDENTITY_PORT=5432
DB_IDENTITY_NAME=pg_identity
DB_PAYMENT_HOST=pgbouncer_payment
DB_PAYMENT_PORT=5432
DB_PAYMENT_NAME=pg_payment
DB_FINANCIAL_HOST=pgbouncer_financial
DB_FINANCIAL_PORT=5432
DB_FINANCIAL_NAME=pg_financial

# ---- Spring Boot per-bounded-context datasources (dipakai tiap service) ----
# identity context
ROLE_DB_HOST=pgbouncer_identity
ROLE_DB_PORT=5432
ROLE_DB_NAME=pg_identity
ROLE_DB_USER=postgres
ROLE_DB_PASSWORD=password
USER_DB_HOST=pgbouncer_identity
USER_DB_PORT=5432
USER_DB_NAME=pg_identity
USER_DB_USER=postgres
USER_DB_PASSWORD=password
AUTH_DB_HOST=pgbouncer_identity
AUTH_DB_PORT=5432
AUTH_DB_NAME=pg_identity
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=password
# payment context
MERCHANT_DB_HOST=pgbouncer_payment
MERCHANT_DB_PORT=5432
MERCHANT_DB_NAME=pg_payment
MERCHANT_DB_USER=postgres
MERCHANT_DB_PASSWORD=password
CARD_DB_HOST=pgbouncer_payment
CARD_DB_PORT=5432
CARD_DB_NAME=pg_payment
CARD_DB_USER=postgres
CARD_DB_PASSWORD=password
SALDO_DB_HOST=pgbouncer_payment
SALDO_DB_PORT=5432
SALDO_DB_NAME=pg_payment
SALDO_DB_USER=postgres
SALDO_DB_PASSWORD=password
TOPUP_DB_HOST=pgbouncer_payment
TOPUP_DB_PORT=5432
TOPUP_DB_NAME=pg_payment
TOPUP_DB_USER=postgres
TOPUP_DB_PASSWORD=password
# financial context
TRANSACTION_DB_HOST=pgbouncer_financial
TRANSACTION_DB_PORT=5432
TRANSACTION_DB_NAME=pg_financial
TRANSACTION_DB_USER=postgres
TRANSACTION_DB_PASSWORD=password
TRANSFER_DB_HOST=pgbouncer_financial
TRANSFER_DB_PORT=5432
TRANSFER_DB_NAME=pg_financial
TRANSFER_DB_USER=postgres
TRANSFER_DB_PASSWORD=password
WITHDRAW_DB_HOST=pgbouncer_financial
WITHDRAW_DB_PORT=5432
WITHDRAW_DB_NAME=pg_financial
WITHDRAW_DB_USER=postgres
WITHDRAW_DB_PASSWORD=password

SECRET_KEY=yantopedia

# Redis Cluster Addrs (6 nodes)
REDIS_ADDRS=redis-node-1:6379,redis-node-2:6379,redis-node-3:6379,redis-node-4:6379,redis-node-5:6379,redis-node-6:6379
REDIS_PASSWORD=dragon_knight
REDIS_DB=0
REDIS_HOST=redis-node-1
REDIS_PORT=6379

# Redis 1 Cluster Addrs (for apigateway)
REDIS_1_ADDRS=redis-node-1:6379,redis-node-2:6379,redis-node-3:6379,redis-node-4:6379,redis-node-5:6379,redis-node-6:6379
REDIS_1_PASSWORD=dragon_knight
REDIS_1_DB=0

# ClickHouse Cluster Config
CLICKHOUSE_ADDR=clickhouse:9000
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USERNAME=dragon
CLICKHOUSE_PASSWORD=dragon_knight
CLICKHOUSE_URL=jdbc:clickhouse://clickhouse:8123/default

KAFKA_BROKERS=kafka-1:9092

APP_LOGGER=production

# Card statement generation day (1-31)
BILLING_CYCLE_DAY=1

# Daily withdrawal limit per card
WITHDRAW_DAILY_LIMIT=10000000

OTEL_ENDPOINT=otel-collector:4317

# ---- Spring Boot gRPC client resolution (gateway + inter-service) ----
# Relaxed binding: GRPC_CLIENT_<NAME>_HOST/_PORT -> grpc.client.<name>.host/port.
GATEWAY_PORT=8080
EMAIL_HTTP_PORT=8092
GRPC_CLIENT_ROLE_HOST=role
GRPC_CLIENT_ROLE_PORT=9006
GRPC_CLIENT_USER_HOST=user
GRPC_CLIENT_USER_PORT=9011
GRPC_CLIENT_AUTH_HOST=auth
GRPC_CLIENT_AUTH_PORT=9012
GRPC_CLIENT_MERCHANT_HOST=merchant
GRPC_CLIENT_MERCHANT_PORT=9005
GRPC_CLIENT_CARD_HOST=card
GRPC_CLIENT_CARD_PORT=9004
GRPC_CLIENT_SALDO_HOST=saldo
GRPC_CLIENT_SALDO_PORT=9007
GRPC_CLIENT_TOPUP_HOST=topup
GRPC_CLIENT_TOPUP_PORT=9008
GRPC_CLIENT_TRANSACTION_HOST=transaction
GRPC_CLIENT_TRANSACTION_PORT=9009
GRPC_CLIENT_TRANSFER_HOST=transfer
GRPC_CLIENT_TRANSFER_PORT=9010
GRPC_CLIENT_WITHDRAW_HOST=withdraw
GRPC_CLIENT_WITHDRAW_PORT=9013
GRPC_CLIENT_STATS_READER_HOST=stats-reader
GRPC_CLIENT_STATS_READER_PORT=9014
GRPC_CLIENT_STATS_HOST=stats-reader
GRPC_CLIENT_STATS_PORT=9014
GRPC_CLIENT_AI_SECURITY_HOST=ai-security
GRPC_CLIENT_AI_SECURITY_PORT=50051

SMTP_SERVER=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=giovani.roberts@ethereal.email
